<%- include('partials/header') %>
<%- include('partials/nav') %>

<main id="main">
  <section class="section">
    <div class="wrap narrow">
      <p class="eyebrow">Firm account</p>
      <h1>Sign in</h1>
      <p class="lead-sm">Use the contact email and password of your firm’s account.</p>

      <% if (message) { %>
        <div class="alert error" role="alert"><p><%= message %></p></div>
      <% } %>

      <form class="form boxed" method="post" action="/sign-in" novalidate>
        <div>
          <label for="email">Contact email</label>
          <input id="email" name="email" type="email" autocomplete="username" required
            value="<%= values.email || '' %>"
            <% if (errors.email) { %>aria-invalid="true" aria-describedby="email-error"<% } %>>
          <% if (errors.email) { %><p class="field-error" id="email-error"><%= errors.email %></p><% } %>
        </div>

        <div>
          <label for="password">Password</label>
          <input id="password" name="password" type="password" autocomplete="current-password" required
            <% if (errors.password) { %>aria-invalid="true" aria-describedby="password-error"<% } %>>
          <% if (errors.password) { %><p class="field-error" id="password-error"><%= errors.password %></p><% } %>
        </div>

        <div class="form-foot">
          <button class="btn primary" type="submit">Sign in</button>
          <span class="muted">New here? <a href="/register">Register your firm</a></span>
        </div>
      </form>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
